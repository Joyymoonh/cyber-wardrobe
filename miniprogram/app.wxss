page{background:#fff8ee;color:#514137;font-size:28rpx}view,text,input,textarea,button{box-sizing:border-box}.page{padding:32rpx 28rpx 70rpx}.title{font-size:48rpx;font-weight:bold;margin:20rpx 0}.muted{color:#927e6e;font-size:24rpx;line-height:1.7}.card{background:#fffdf8;border:3rpx solid #d9c6af;border-radius:30rpx;padding:26rpx;margin:22rpx 0;box-shadow:0 8rpx 0 #eadbc8}.row{display:flex;align-items:center;gap:16rpx;flex-wrap:wrap}.field{background:#f6edde;border:2rpx solid #ddcbb4;border-radius:18rpx;padding:20rpx;margin:18rpx 0;min-height:84rpx}input{width:100%}button{background:#f3c9b9;color:#514137;border:2rpx solid #514137;border-radius:22rpx;font-size:28rpx;margin:18rpx 0}button::after{border:0}button[disabled]{opacity:.5}.secondary{background:#e1ecdf}.small{font-size:24rpx;margin:6rpx}.error{background:#ffe1d9;padding:20rpx;border-radius:18rpx;color:#933f30}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.item{padding:18rpx;margin:0}.photo{width:100%;height:260rpx;background:#eee2d2;border-radius:18rpx}.preview{width:100%;height:440rpx;background:#ede6d9;border-radius:24rpx}.chip{padding:12rpx 22rpx;background:#ede1d0;border-radius:22rpx;font-size:24rpx}.selected{background:#bed5bf}.cabinet{background:#e7cfac;border:8rpx solid #b38e69;border-radius:36rpx;padding:20rpx;margin-top:24rpx}.empty{text-align:center;padding:70rpx 18rpx}.hanger{font-size:72rpx;text-align:center}.section{font-weight:bold;font-size:32rpx;margin:22rpx 0}.outfit-item{width:120rpx;height:140rpx;border-radius:18rpx;background:#eee2d2}textarea{width:100%}
