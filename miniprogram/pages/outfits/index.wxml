<view class="page"><view class="title">今日穿搭灵感</view><view class="muted">从已有衣服组合造型 · 固定人偶配色示意与单品搭配板</view><view class="card"><picker range="{{styles}}" range-key="label" value="{{styleIndex}}" data-key="styleIndex" bindchange="field" disabled="{{busy}}"><view class="field">风格：{{styles[styleIndex].label}} ▾</view></picker><picker range="{{seasons}}" range-key="label" value="{{seasonIndex}}" data-key="seasonIndex" bindchange="field" disabled="{{busy}}"><view class="field">季节：{{seasons[seasonIndex].label}} ▾</view></picker><input class="field" value="{{occasion}}" placeholder="场景，如约会、上班" data-key="occasion" bindinput="field" disabled="{{busy}}"/><button bindtap="generate" loading="{{busy}}" disabled="{{busy}}">生成搭配</button><button class="secondary" bindtap="saved" disabled="{{busy}}">查看我的穿搭本</button></view><button class="secondary" bindtap="doll">切换人偶：{{doll==='female'?'女款':'男款'}}</button><view wx:if="{{notice}}" class="muted">{{notice}}</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:for="{{results}}" wx:key="index" class="card" wx:for-index="outfitIndex"><view class="section">{{item.title}}</view><outfit-doll items="{{item.clothes}}" model="{{doll}}"/><view class="row"><view wx:for="{{item.clothes}}" wx:for-item="cloth" wx:key="id"><image wx:if="{{cloth.photo}}" src="{{cloth.photo}}" mode="aspectFit" class="outfit-item"/><view class="muted">{{cloth.name}}</view></view></view><view>{{item.reasoning}}</view><view class="muted">{{item.tips}}</view><button wx:if="{{!saved}}" disabled="{{busy || item.stored}}" data-index="{{outfitIndex}}" bindtap="save">{{item.stored?'已收藏':'收藏这套'}}</button><button wx:else disabled="{{busy}}" data-id="{{item.id}}" bindtap="remove">移出穿搭本</button></view><view wx:if="{{saved && !results.length}}" class="empty">还没有收藏穿搭</view></view>
