<view class="page"><view class="title">我的小衣柜</view><view class="muted">今天也要穿得开心 · {{items.length}} 件衣物</view><button bindtap="add">＋ 放进衣柜</button><input class="field" placeholder="搜索名称或颜色" bindinput="query"/><scroll-view scroll-x><view class="row" style="flex-wrap:nowrap;width:max-content"><view class="chip {{category===''?'selected':''}}" data-id="" bindtap="category">全部</view><view wx:for="{{categories}}" wx:key="id" class="chip {{category===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="category">{{item.label}}</view></view></scroll-view><button class="small secondary" bindtap="favorite">{{favorite?'♥ 仅看收藏':'♡ 查看收藏'}}</button><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><view wx:if="{{loading}}" class="muted">正在整理衣柜…</view><view class="cabinet"><view class="grid"><view wx:for="{{shown}}" wx:key="id" class="card item" data-id="{{item.id}}" bindtap="edit"><image wx:if="{{item.photo}}" src="{{item.photo}}" mode="aspectFit" class="photo"/><view wx:else class="photo empty">♧</view><view>{{item.favorite?'♥ ':''}}{{item.name}}</view><view class="muted">{{item.color}}</view></view></view><view wx:if="{{!shown.length && !loading}}" class="empty">这里还没有衣服，放一件进来吧</view></view></view>