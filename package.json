{
  "name": "cyber-wardrobe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "node --disable-warning=ExperimentalWarning .next/standalone/server.js",
    "lint": "eslint",
    "test": "vitest run",
    "postbuild": "cp -R public .next/standalone/ && cp -R .next/static .next/standalone/.next/",
    "setup:segmentation": "node scripts/setup-segmentation.mjs",
    "start:cloud": "node scripts/start-cloud.mjs",
    "setup:cloud": "node --env-file-if-exists=.env.cloud.local scripts/setup-supabase.mjs",
    "check:cloud": "node --env-file-if-exists=.env.cloud.local scripts/check-cloud.mjs",
    "package:cloud": "node scripts/package-cloud.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@mediapipe/tasks-vision": "1.2.0",
    "clsx": "2.1.1",
    "lucide-react": "1.62.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "pg-mem": "^3.0.14",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.5"
  }
}
